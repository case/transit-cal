#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

# Runs the production image's nightly build against a local feeds directory
IMAGE="${IMAGE:-transit-cal:local}"
FEEDS="${FEEDS:-$PWD/out/feeds}"

if [ -z "${TRANSITLAND_API_KEY:-}" ]; then
  echo "Error: set TRANSITLAND_API_KEY to a Transitland API key." >&2
  exit 1
fi
if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  echo "Error: image $IMAGE not found. Run bin/build-image." >&2
  exit 1
fi

mkdir -p "$FEEDS"
# The key passes by name, so its value never appears in the process list
exec docker run --rm --user 10002:10002 --read-only --tmpfs /tmp \
  -v "$FEEDS":/feeds \
  -e TRANSITLAND_API_KEY \
  --entrypoint build-feeds \
  "$IMAGE"
