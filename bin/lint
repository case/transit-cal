#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

for tool in actionlint caddy dprint editorconfig-checker hadolint ruff shellcheck shfmt uv; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "Error: $tool not found on PATH. Run bin/setup." >&2
    exit 1
  fi
done

echo "==> dprint check"
dprint check

# Every git-tracked file, including ones no formatter covers
echo "==> editorconfig-checker"
editorconfig-checker

echo "==> ruff check"
ruff check

echo "==> ruff format"
ruff format --check

# ty is a dev dependency, so it runs from the locked uv environment
echo "==> ty"
uv run --locked ty check --error-on-warning

echo "==> shellcheck"
shellcheck bin/*

# shfmt reads .editorconfig
echo "==> shfmt"
shfmt -d bin/

# actionlint also runs shellcheck on run: blocks
echo "==> actionlint"
actionlint

echo "==> hadolint"
hadolint Dockerfile

echo "==> caddy fmt"
caddy fmt --diff Caddyfile >/dev/null

echo "==> caddy validate"
caddy validate --config Caddyfile --adapter caddyfile

echo
echo "✅ Lint passed."
