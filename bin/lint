#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

for tool in actionlint caddy dprint editorconfig-checker hadolint ruff shellcheck shfmt uv; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "Error: $tool not found on PATH. Run bin/setup." >&2
    exit 1
  fi
done

echo "==> dprint check"
dprint check

# Every git-tracked file, including ones no formatter covers
echo "==> editorconfig-checker"
editorconfig-checker

echo "==> ruff check"
ruff check

echo "==> ruff format"
ruff format --check

# ty is a dev dependency, so it runs from the locked uv environment
echo "==> ty"
uv run --locked ty check --error-on-warning

# bin/ also holds Python scripts, which ruff and ty check
echo "==> shellcheck"
grep -l '^#!/usr/bin/env bash' bin/* | xargs shellcheck

# shfmt reads .editorconfig
echo "==> shfmt"
grep -l '^#!/usr/bin/env bash' bin/* | xargs shfmt -d

# actionlint also runs shellcheck on run: blocks
echo "==> actionlint"
actionlint

echo "==> hadolint"
hadolint Dockerfile

echo "==> caddy fmt"
for file in Caddyfile Caddyfile.common Caddyfile.dev; do
  caddy fmt --diff "$file" >/dev/null
done

echo "==> caddy validate"
caddy validate --config Caddyfile --adapter caddyfile
caddy validate --config Caddyfile.dev --adapter caddyfile

echo
echo "✅ Lint passed."
