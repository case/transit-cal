#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

if ! command -v mise >/dev/null 2>&1; then
  echo "==> Installing mise"
  curl -fsSL https://mise.run | sh
  export PATH="$HOME/.local/bin:$PATH"
  echo "Activate mise in your shell: https://mise.jdx.dev/getting-started.html"
fi

# Installs only what mise.toml lists and is missing
echo "==> mise install"
mise install

# mise exec, since the tools aren't on PATH until mise is activated
# --locked fails when uv.lock is out of date with pyproject.toml
echo "==> uv sync"
mise exec -- uv sync --locked

echo "==> pnpm install"
mise exec -- pnpm --dir web install

# CI also needs Chromium's system libraries
echo "==> playwright install"
if [ -n "${CI:-}" ]; then
  mise exec -- pnpm --dir web exec playwright install --with-deps chromium
else
  mise exec -- pnpm --dir web exec playwright install chromium
fi

echo
echo "✅ Setup done."
