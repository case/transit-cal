#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

# ical4j as baked into the production image by bin/build-image
IMAGE="${IMAGE:-transit-cal:local}"

if ! command -v uv >/dev/null 2>&1; then
  echo "Error: uv not found on PATH. Run bin/setup." >&2
  exit 1
fi
if ! docker info >/dev/null 2>&1; then
  echo "Error: Docker daemon not reachable." >&2
  exit 1
fi
if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  echo "Error: image $IMAGE not found. Run bin/build-image." >&2
  exit 1
fi

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

# Validates the named files, relative to the directory in $1, offline as production runs it
validate() {
  local dir="$1"
  shift
  docker run --rm --network none --read-only --user 10002:10002 \
    -v "$dir":/work:ro \
    --workdir /work \
    --entrypoint ics-validate \
    "$IMAGE" "$@"
}

echo "==> build synthetic feeds"
uv run --locked python -m zipfile -c "$work/gtfs.zip" tests/fixtures/synthetic/gtfs/*.txt
SOURCE_DATE_EPOCH=1790000000 uv run --locked transit-cal build "$work/gtfs.zip" \
  --operators tests/fixtures/synthetic/operators --out "$work/feeds" \
  --start 2026-10-06 --days 14 >/dev/null

# A read loop, not mapfile, so macOS's bundled Bash 3.2 can run this
feeds=()
while IFS= read -r feed; do
  feeds+=("$feed")
done < <(cd "$work/feeds" && find . -name '*.ics' | sort)
if [ "${#feeds[@]}" -eq 0 ]; then
  echo "Error: the build wrote no feeds." >&2
  exit 1
fi

echo "==> ical4j: ${#feeds[@]} synthetic feeds"
validate "$work/feeds" "${feeds[@]}"

# Proves the validator rejects a bad feed, so the step above cannot pass vacuously
echo "==> ical4j: a known-bad feed must fail"
status=0
out="$(validate "$PWD/tests/fixtures" invalid-feed.ics)" || status=$?
if [ "$status" -ne 1 ] || ! grep -q '^invalid-feed.ics: INVALID' <<<"$out"; then
  echo "$out" >&2
  echo "Error: expected ical4j to reject invalid-feed.ics (exit $status)." >&2
  exit 1
fi

echo
echo "✅ Feeds valid."
